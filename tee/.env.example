# RPC URLs (comma-separated for fallback)
RPC_URLS=https://sepolia-rollup.arbitrum.io/rpc

# Contract Addresses (Arbitrum Sepolia)
ORDER_QUEUE_ADDRESS=0x...
STATE_ANCHOR_ADDRESS=0x...
PRIVATE_TOKEN_ADDRESS=0x...
MARKET_FACTORY_ADDRESS=0x...

# IPFS Configuration
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# TEE Configuration
TEE_PRIVATE_KEY=  # Only set for local development, use iExec secrets in production
POLLING_INTERVAL_MS=3000
SNAPSHOT_INTERVAL_MATCHES=100

# Logging
LOG_LEVEL=info
