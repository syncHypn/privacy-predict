{
  "name": "ipred-tee",
  "version": "1.0.0",
  "description": "iPred TEE Matching Engine for iExec",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ethereumjs/trie": "^6.2.0",
    "@ethereumjs/util": "^9.0.0",
    "iexec": "^8.7.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "viem": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
